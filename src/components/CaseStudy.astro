---
interface Props {
  title: string;
  category: string;
  description: string;
  githubUrl?: string;
  externalUrl?: string;
  technologies?: string[];
}

const { title, category, description, githubUrl, externalUrl, technologies = [] } = Astro.props;
---

<div class="case-study-header">
  <p class="case-study-category">{category}</p>
  <h1>{title}</h1>
  <p class="case-study-description">{description}</p>

  {technologies.length > 0 && <p>{technologies.join(', ')}</p>}

  <p class="case-study-links">
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
    )}
    {githubUrl && externalUrl && ' · '}
    {externalUrl && (
      <a href={externalUrl} target="_blank" rel="noreferrer">Article</a>
    )}
  </p>
</div>

<div class="case-study-content">
  <slot />
</div>

<style>
  .case-study-header {
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .case-study-category {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  h1 {
    margin: 0.35rem 0 0.25rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .case-study-description {
    margin: 1.1rem 0 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .case-study-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
  }

  .case-study-content :global(h2) {
    margin: 2rem 0 0.45rem;
    font-size: 1.05rem;
    font-weight: 600;
    border: 0;
    padding: 0;
  }

  .case-study-content :global(h3) {
    margin: 1.25rem 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .case-study-content :global(code),
  .case-study-content :global(pre) {
    background: var(--code-bg);
    color: var(--text-primary);
  }

  .case-study-content :global(pre) {
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }

  .case-study-content :global(blockquote) {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 1px solid var(--border-color);
  }

  .case-study-content :global(.highlight-box) {
    margin: 1.25rem 0;
    padding: 0.15rem 0 0.35rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    background: transparent;
  }

  .case-study-content :global(.highlight-box h3) {
    margin-top: 0.85rem;
  }
</style>
