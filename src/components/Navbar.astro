---
const links = [
  { id: 'nav-work', href: '/work/', label: 'Work' },
  { id: 'nav-writing', href: '/writing/', label: 'Writing' },
  { id: 'nav-research', href: '/research/', label: 'Research' },
];
---
<nav id="nav" aria-label="Site">
  <ul class="nav-wide">
    {links.map((l) => <li><a id={l.id} href={l.href}>{l.label}</a></li>)}
  </ul>
  <details class="nav-narrow">
    <summary aria-label="Menu">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M3 18h18v-2H3zm0-5h18v-2H3zm0-7v2h18V6z"/></svg>
    </summary>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </details>
</nav>
