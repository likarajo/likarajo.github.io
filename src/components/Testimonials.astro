---
/**
 * Testimonials Component
 *
 * Displays testimonials, recommendations, or project outcomes.
 * Only include PUBLIC testimonials with explicit permission.
 *
 * Usage:
 * import Testimonials from '../components/Testimonials.astro';
 *
 * <Testimonials
 *   testimonials={[
 *     {
 *       quote: "Excellent work on...",
 *       author: "Name",
 *       role: "Title, Organization",
 *       link: "https://linkedin.com/in/profile"
 *     }
 *   ]}
 * />
 */

interface Testimonial {
  quote: string;
  author: string;
  role?: string;
  organization?: string;
  link?: string; // LinkedIn profile, website, etc.
  date?: string;
  type?: 'recommendation' | 'feedback' | 'award' | 'outcome';
}

interface Props {
  testimonials: Testimonial[];
  title?: string;
  variant?: 'default' | 'compact';
}

const {
  testimonials,
  title = "Testimonials",
  variant = 'default',
} = Astro.props;
---

{testimonials.length > 0 && (
  <section class={`testimonials variant-${variant}`}>
    {title && <h3 class="testimonials-title">{title}</h3>}
    <div class="testimonials-grid">
      {testimonials.map((testimonial) => (
        <article class="testimonial-card">
          <blockquote class="testimonial-quote">
            "{testimonial.quote}"
          </blockquote>
          <footer class="testimonial-footer">
            {testimonial.link ? (
              <a href={testimonial.link} target="_blank" rel="noreferrer" class="testimonial-author">
                <strong>{testimonial.author}</strong>
              </a>
            ) : (
              <strong class="testimonial-author">{testimonial.author}</strong>
            )}
            {(testimonial.role || testimonial.organization) && (
              <div class="testimonial-role">
                {testimonial.role}
                {testimonial.role && testimonial.organization && ", "}
                {testimonial.organization}
              </div>
            )}
            {testimonial.date && (
              <time class="testimonial-date">{testimonial.date}</time>
            )}
          </footer>
        </article>
      ))}
    </div>
  </section>
)}

{testimonials.length === 0 && (
  <div class="testimonials-placeholder">
    <p>
      <!-- Placeholder when no testimonials are added yet -->
      <!-- This component is ready to use when you have public testimonials to display -->
    </p>
  </div>
)}

<style>
  .testimonials {
    margin: 3rem 0;
  }

  .testimonials-title {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid #e0e0e0;
    padding-bottom: 0.5rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .testimonial-card {
    background: #f9f9f9;
    border-left: 4px solid #4a90e2;
    padding: 1.5rem;
    border-radius: 4px;
  }

  .testimonial-quote {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1rem 0;
    font-style: italic;
  }

  .testimonial-footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e0e0e0;
  }

  .testimonial-author {
    color: #4a90e2;
    text-decoration: none;
    font-size: 1rem;
  }

  .testimonial-author:hover {
    text-decoration: underline;
  }

  .testimonial-role {
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.25rem;
  }

  .testimonial-date {
    display: block;
    font-size: 0.75rem;
    color: #999;
    margin-top: 0.5rem;
  }

  /* Compact variant */
  .variant-compact .testimonials-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .variant-compact .testimonial-card {
    padding: 1rem;
  }

  .variant-compact .testimonial-quote {
    font-size: 1rem;
  }

  .testimonials-placeholder {
    display: none;
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

