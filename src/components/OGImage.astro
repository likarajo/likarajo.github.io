---
/**
 * Open Graph Image Component
 *
 * Generates social media preview images for pages.
 * Place custom OG images in /public/images/og/
 *
 * Usage:
 * import OGImage from '../components/OGImage.astro';
 * const ogImageUrl = OGImage.getUrl('page-name');
 *
 * Then use in <meta property="og:image" content={ogImageUrl} />
 */

interface Props {
  title: string;
  description?: string;
  imagePath?: string; // Custom image path in /public/images/og/
}

const { title, description, imagePath } = Astro.props;
const site = Astro.site ?? new URL('https://likarajo.github.io');

// Use custom image if provided, otherwise fall back to default profile image
const ogImage = imagePath
  ? new URL(`/images/og/${imagePath}`, site).href
  : new URL('/images/site/profile.jpg', site).href;

/**
 * Helper function to get OG image URL
 * Call this from pages to get the full URL for meta tags
 */
export function getOGImageUrl(imageName?: string): string {
  const site = new URL('https://likarajo.github.io');
  return imageName
    ? new URL(`/images/og/${imageName}`, site).href
    : new URL('/images/site/profile.jpg', site).href;
}
---

<!-- This component doesn't render anything, it's just for generating URLs -->
<!-- The actual OG meta tags are in Base.astro -->

<!--
CREATING CUSTOM OG IMAGES:

1. Create images at 1200x630px (Facebook/LinkedIn recommended size)
2. Save as JPG or PNG in /public/images/og/
