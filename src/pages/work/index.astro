---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Work', url: '/work/' },
];
---
<Base
  title="Work"
  description="Public projects in trustworthy AI, natural language interfaces to data, and machine learning applications for energy infrastructure and public benefit."
  breadcrumbs={breadcrumbs}
>
  <main class="profile">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Work' }]} />
    <h1>Work</h1>
    <p class="lead">
      Public projects in trustworthy AI, natural language interfaces to data, and machine learning.
    </p>

    <section class="example">
      <h2>AI Agent Chatbot for Energy Data</h2>
      <p>
        A plain-language question about U.S. electricity generation becomes one checked query.
        A question the table cannot answer is refused.
      </p>
      <p>
        <a href="/work/ai-agent-chatbot/">Case study</a>
        {" Â· "}
        <a href="https://github.com/likarajo/ai-agent-chatbot" target="_blank" rel="noreferrer">GitHub</a>
      </p>
    </section>

    <section>
      <h2>More projects</h2>
      <ul>
        <li>
          <a href="/work/language-translation/">Neural machine translation</a>
          {" "}â€” a sequence-to-sequence model that translates a sentence from one language into another.
          {" "}
          <a href="https://github.com/likarajo/language_translation" target="_blank" rel="noreferrer">GitHub</a>
        </li>
        <li>
          <a href="/work/covid19-sentiments/">COVID-19 sentiment analysis</a>
