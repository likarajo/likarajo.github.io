---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { displayYear, statusLabel } from '../../lib/publishing';

const studies = (await getCollection('studies', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
---
<Base title="Research" description="Research studies by Rajarshi Chattopadhyay.">
  <main class="profile" id="research">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'Research' }]} />
    <h1>Research</h1>
    <p>Research studies by Rajarshi Chattopadhyay. Each published study has its own citable page.</p>
    {studies.length > 0 && (
      <ul class="piece-list">
        {studies.map((study) => (
          <li>
            <a class="text-link" href={`/research/${study.id}/`}>{study.data.title}</a>
            <p class="piece-year">{displayYear(study.data)} · {statusLabel(study.data.status)}</p>
            <p>{study.data.abstract}</p>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
